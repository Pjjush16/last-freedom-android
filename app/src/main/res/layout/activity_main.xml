<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左上角数据来源署名 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="#80000000"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:alpha="0.7">

        <TextView
            android:id="@+id/tvAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© OpenStreetMap contributors"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvAttributionEsri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imagery © Esri"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 右上角速度表 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:background="#80000000"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#80000000"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnMapMode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_mapmode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="地图模式" />

            <ImageButton
                android:id="@+id/btnPickPoint"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="选点"
                android:layout_marginStart="16dp" />

            <ImageButton
                android:id="@+id/btnCenter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="居中"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRoadName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待定位..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvCoordinate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Dock 控制栏 -->
    <LinearLayout
        android:id="@+id/zoomDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:background="@drawable/zoom_dock_bg"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/btn_minus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="缩小" />

        <TextView
            android:id="@+id/tvZoomLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/btn_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="放大" />
    </LinearLayout>

    <!-- 地图模式选择器 -->
    <LinearLayout
        android:id="@+id/mapModeSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="120dp"
        android:orientation="vertical"
        android:background="@drawable/map_picker_bg"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/modeSatelliteRoad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卫星+路网"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/modeSatellite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卫星"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/modeStandard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标准"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 选点模式控制 -->
    <LinearLayout
        android:id="@+id/pickModeControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="拖动地图选择位置"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCancelPick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmPick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确认" />
    </LinearLayout>

    <!-- 准星覆盖层 -->
    <View
        android:id="@+id/crosshairOverlay"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 选点提示 -->
    <TextView
        android:id="@+id/pickerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:text="拖动地图选择目的地"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- 选点按钮栏 -->
    <LinearLayout
        android:id="@+id/pickerButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnPickerCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnPickerConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确认" />
    </LinearLayout>

    <!-- 左下角贴纸 -->
    <WebView
        android:id="@+id/stickerLeft"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp" />

    <!-- 右下角贴纸 -->
    <WebView
        android:id="@+id/stickerRight"
        android:layout_width="72dp"
        android:layout_height="105dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp" />

</FrameLayout>
